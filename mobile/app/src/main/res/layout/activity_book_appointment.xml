<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:text="Book an Appointment"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Fill in the details below to schedule your clinic visit"
            android:textSize="13sp"
            android:textColor="#667085"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Reason -->
        <TextView android:text="Reason for Visit *"
            android:textSize="13sp" android:textColor="@color/brand_primary"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Fever, Check-up, Consultation"
            android:background="@drawable/input_background"
            android:textColor="@color/black"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- Date picker -->
        <TextView android:text="Preferred Date *"
            android:textSize="13sp" android:textColor="@color/brand_primary"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick a date"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#185FA5"
            android:layout_marginBottom="8dp"/>

        <!-- Availability badge -->
        <TextView
            android:id="@+id/tvAvailabilityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:background="@drawable/badge_background"/>

        <!-- Slots loading indicator -->
        <TextView
            android:id="@+id/tvSlotsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking availability..."
            android:textSize="13sp"
            android:textColor="#888888"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- Time slot section label -->
        <TextView
            android:id="@+id/tvSlotLabel"
            android:text="Select a Time Slot *"
            android:textSize="13sp"
            android:textColor="#344054"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Slot grid (3 columns via nested LinearLayouts, populated in code) -->
        <GridLayout
            android:id="@+id/slotGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- Legend -->
        <LinearLayout
            android:id="@+id/slotLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/legend_available"
                android:layout_gravity="center_vertical"/>
            <TextView android:text=" Available  " android:textSize="12sp" android:textColor="#667085"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/legend_selected"
                android:layout_gravity="center_vertical"/>
            <TextView android:text=" Selected  " android:textSize="12sp" android:textColor="#667085"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/legend_taken"
                android:layout_gravity="center_vertical"/>
            <TextView android:text=" Taken" android:textSize="12sp" android:textColor="#667085"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Notes -->
        <TextView android:text="Additional Notes (optional)"
            android:textSize="13sp" android:textColor="@color/brand_primary"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Any additional information..."
            android:minLines="3"
            android:gravity="top"
            android:background="@drawable/input_background"
            android:textColor="@color/black"
            android:padding="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- File attach -->
        <Button
            android:id="@+id/btnAttachFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📎 Attach Document (optional)"
            android:backgroundTint="#F9FAFB"
            android:textColor="#344054"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#667085"
            android:layout_marginBottom="16dp"/>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:backgroundTint="#F2F4F7"
                android:textColor="#344054"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit Appointment"
                android:backgroundTint="#185FA5"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
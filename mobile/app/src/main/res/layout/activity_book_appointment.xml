<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f6ff"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book an Appointment"
            android:textColor="#0355A1"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill in the details below"
            android:textColor="#397EBF"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Reason for Visit *" android:textColor="#0355A1"
                android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. Fever, Check-up, Consultation"
                android:background="@drawable/bg_field"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Preferred Date *" android:textColor="#0355A1"
                android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No date selected"
                android:textColor="#397EBF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPickDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pick Date"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Preferred Time *" android:textColor="#0355A1"
                android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No time selected"
                android:textColor="#397EBF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPickTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pick Time"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Additional Notes (optional)" android:textColor="#0355A1"
                android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Any additional information..."
                android:background="@drawable/bg_field"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attach Document (optional)" android:textColor="#0355A1"
                android:textStyle="bold" android:textSize="14sp" android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No file selected"
                android:textColor="#397EBF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnAttachFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📎 Choose File (PDF/Image)"
                android:textColor="#0355A1"
                android:backgroundTint="#B2CEE8"
                android:stateListAnimator="@null"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit Appointment"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Cancel"
                android:textColor="#0355A1"
                android:backgroundTint="#B2CEE8"
                android:stateListAnimator="@null"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>